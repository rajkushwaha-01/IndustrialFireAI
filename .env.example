# ==============================================================================
# IndustrialFireAI - Environment Configuration Template
# Problem Statement 26162 (NTRO)
# 
# Instructions:
# 1. Copy this file to '.env' before running docker-compose or local services:
#    cp .env.example .env
# 2. Update with your specific deployment credentials and keys as appropriate.
# 3. DO NOT commit production secrets, keys, or passwords into version control.
# ==============================================================================

# --- Application Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=5000
ML_PORT=8000
POSTGRES_PORT=5432

# --- Database Configuration (PostGIS) ---
POSTGRES_DB=industrial_fire_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=db

# --- Backend Service Configuration ---
NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/industrial_fire_db
ML_SERVICE_URL=http://ml-service:8000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost

# --- NASA FIRMS Ingestion API Configuration ---
# Obtain your free map key from: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=your_nasa_firms_map_key_here
FIRMS_DEFAULT_SOURCE=VIIRS_NOAA20_NRT
FIRMS_DEFAULT_COUNTRY=IND
FIRMS_AUTO_SYNC_ENABLED=false
FIRMS_SYNC_INTERVAL_HOURS=24

# --- ML Service Configuration ---
MODEL_PATH=/app/model/fire_type_model.pkl

# --- Frontend Build & Client Configuration ---
# Set to '/api' when using Nginx reverse proxy, or 'http://localhost:5000/api' for direct access
VITE_API_URL=/api
VITE_ML_SERVICE_URL=http://localhost:8000

# Satellite Tile Provider (Optional - leave empty for free public OSM fallback)
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here
